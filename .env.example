# Copy this file to `.env` and fill in the values: cp .env.example .env
# `.env` is ignored by git. Never commit real keys. This file only lists the variables.

# --- LLM (any OpenAI-compatible API) ---
# Option A: Groq, free tier. Get a key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Option B: Ollama, running locally. Comment out option A and use these instead.
# Ollama needs no key, but the client still expects a value, so any text works.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# --- Elasticsearch ---
# Where the agent sends its ES|QL queries. This is the local Docker container.
ELASTICSEARCH_URL=http://localhost:9200
