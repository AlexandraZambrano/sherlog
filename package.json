{
  "name": "sherlog",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "version": "0.1.0",
  "description": "An AI agent that investigates production incidents using logs, metrics and traces from Elasticsearch.",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.pipeline.test.ts'",
    "test:pipeline": "vitest run pipeline",
    "test:integration": "vitest run integration",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandraZambrano/sherlog.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlexandraZambrano/sherlog/issues"
  },
  "homepage": "https://github.com/AlexandraZambrano/sherlog#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1"
  }
}
