# Dependencies: reinstalled with `npm install`, never committed
node_modules/

# Build output: generated by the compiler
dist/
build/
*.tsbuildinfo

# Test output
coverage/

# Secrets and local settings: only `.env.example` is committed
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Operating system and editor files
.DS_Store
.idea/
.vscode/
